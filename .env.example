# Sao chép thành .env rồi điền giá trị thật. Không commit .env.
# Mọi ô trống là bắt buộc: docker compose báo lỗi nếu thiếu (${VAR:?}), vicap.config báo MissingEnvError.
# Mật khẩu chỉ dùng chữ + số (nằm trong URL kết nối Postgres). Sinh nhanh:
#   python -c "import secrets; print(secrets.token_hex(16))"
# Địa chỉ dưới đây là địa chỉ nhìn từ máy host; trong container, docker-compose.yml tự đè
# (minio:9000, iceberg-rest:8181, kafka:9092, clickhouse, mlflow:5000).

# ── Postgres (DB airflow, iceberg, mlflow, superset) ──
POSTGRES_USER=vicap
POSTGRES_PASSWORD=

# ── MinIO ──
MINIO_ENDPOINT=http://localhost:9000
# root: chỉ minio + minio-init dùng, không đưa vào code
MINIO_ROOT_USER=vicap-root
MINIO_ROOT_PASSWORD=
# user vicap-crawler: ghi raw/ (vicap.config.crawler_minio_config)
MINIO_CRAWLER_ACCESS_KEY=vicap-crawler
MINIO_CRAWLER_SECRET_KEY=
# user vicap-pipeline: đọc raw/, ghi lakehouse/ + mlflow/ (MinioConfig, IcebergConfig, MLflow)
AWS_ACCESS_KEY_ID=vicap-pipeline
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Iceberg REST catalog ──
CATALOG_URI_CLIENT=http://localhost:8181
CATALOG_WAREHOUSE=s3://lakehouse/warehouse/

# ── ClickHouse (DB cố định là vicap, xem infra/clickhouse/init.sql) ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=vicap
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=vicap

# ── Kafka (listener HOST; trong container là kafka:9092) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_VIDEOS=tiktok.videos

# ── Airflow 3 ──
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# ── MLflow ──
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Superset (user admin) ──
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=

# ── Encoder (PLAN mục 4.1) — đổi encoder thì phải tính lại gold.features ──
TEXT_ENCODER=vinai/phobert-base
IMAGE_ENCODER=google/siglip2-base-patch16-224

# ── Cổng trên host (tuỳ chọn) ──
# POSTGRES_PORT=5432  MINIO_PORT=9000  MINIO_CONSOLE_PORT=9001  CATALOG_PORT=8181
# CLICKHOUSE_NATIVE_PORT=9002  KAFKA_HOST_PORT=29092  AIRFLOW_PORT=8080  MLFLOW_PORT=5000  SUPERSET_PORT=8088
