# Sao chép thành .env rồi điền giá trị thật. Không commit .env.

# MinIO / S3 (bắt buộc)
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Iceberg REST catalog
CATALOG_URI_CLIENT=http://localhost:8181
CATALOG_WAREHOUSE=s3://lakehouse/warehouse/

# ClickHouse (user / password bắt buộc)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=vicap

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_VIDEOS=tiktok.videos

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Encoder (PLAN mục 4.1) — đổi encoder thì phải tính lại gold.features
TEXT_ENCODER=vinai/phobert-base
IMAGE_ENCODER=google/siglip2-base-patch16-224
